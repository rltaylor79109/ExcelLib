=LAMBDA(
  pWtKg,
  pHtCm,
  LET(
    _functionName,
    N(
      "fn_BMI_METRIC"
    ),
    _comment,
    N(
      "Calculates Body Mass Index (BMI) using metric unit for height and weight, centimeters and kilograms."
    ),
    pHtM,
    pHtCm / c_CM_PER_METER,
    _result,
    pWtKg /(
      pHtM * pHtM
    ),
    _result
  )
)