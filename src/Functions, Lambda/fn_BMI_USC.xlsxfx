=LAMBDA(
  pWtLbs,
  pHtInches,
  LET(
    _functionName,
    N(
      "fn_BMI_USC"
    ),
    _comment,
    N(
      "Calculates Body Mass Index (BMI) using U.S. Customary units for height and weight, inches and pounds."
    ),
    _wtKg,
    pWtLbs / c_POUNDS_PER_KILOGRAM,
    _htCm,
    pHtInches / c_INCHES_PER_METER * c_CM_PER_METER,
    _result,
    fn_BMI_METRIC(
      _wtKg,
      _htCm
    ),
    _result
  )
)