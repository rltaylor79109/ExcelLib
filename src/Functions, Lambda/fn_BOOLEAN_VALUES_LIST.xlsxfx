=LAMBDA(
  LET(
    _functionName,
    N(
      "fn_BOOLEAN_VALUES_LIST"
    ),
    _comment,
    N(
      "Gets a list of allowable boolean value, True and False. It is typcially used indirectly as a data validation source."
    ),
    _result,
    TRANSPOSE(
      TOCOL(
        {
          TRUE,
          FALSE
        }
      )
    ),
    _result
  )
)