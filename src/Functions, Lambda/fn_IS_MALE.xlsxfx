=LAMBDA(
  pSexStr,
  LET(
    _functionName,
    N(
      "fn_IS_MALE"
    ),
    _comment,
    N(
      "If the input is 'M' or 'Male' then TRUE; if it is 'F' or 'Female' then FALSE; otherwise #N/A. It is case insenstive."
    ),
    _result,
    SWITCH(
      UPPER(
        TRIM(
          pSexStr
        )
      ),
      "F",
      FALSE,
      "FEMALE",
      FALSE,
      "M",
      TRUE,
      "MALE",
      TRUE,
      NA(
      )
    ),
    _result
  )
)