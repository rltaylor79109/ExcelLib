=LAMBDA(
  pSexStr,
  LET(
    _functionName,
    N(
      "NEEDS REVISION, function name: fn_IS_MALE"
    ),
    _result,
    SWITCH(
      UPPER(
        TRIM(
          pSexStr
        )
      ),
      "F",
      FALSE,
      "FEMALE",
      FALSE,
      "M",
      TRUE,
      "MALE",
      TRUE,
      NA(
      )
    ),
    _result
  )
)