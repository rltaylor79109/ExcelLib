=LAMBDA(
  pAnyCellInSheet,
  LET(
    _functionName,
    N(
      "NEEDS REVISION, GetWorksheetName"
    ),
    _pathPlusSheetName,
    CELL(
      "filename",
      pAnyCellInSheet
    ),
    _startPos,
    FIND(
      "]",
      _pathPlusSheetName
    ) + 1,
    _maxSheetNameLen,
    31,
    _result,
    MID(
      _pathPlusSheetName,
      _startPos,
      _maxSheetNameLen
    ),
    _result
  )
)