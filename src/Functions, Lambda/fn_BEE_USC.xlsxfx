=LAMBDA(
  pWtLbs,
  pHtInches,
  pAgeYears,
  pIsMale,
  LET(
    _functionName,
    N(
      "NEEDS REVISION, function name: fn_BEE_USC"
    ),
    _wtKg,
    pWtLbs / c_POUNDS_PER_KILOGRAM,
    _htM,
    pHtInches / c_INCHES_PER_METER,
    _htCm,
    _htM * c_CM_PER_METER,
    _result,
    fn_BEE_METRIC(
      _wtKg,
      _htCm,
      pAgeYears,
      pIsMale
    ),
    _result
  )
)