=LAMBDA(
  pStartRng,
  pStepCount,
  pIntervalLen,
  LET(
    _functionName,
    N(
      "fn_SUM_INTERVALS"
    ),
    _comment,
    N(
      "Sums a ranges values spaced by an interval. For example SUM_INTERVALS(12345678,2,3) would sum 1, 3, 5."
    ),
    _seq,
    SEQUENCE(
      pStepCount,
      1,
      0
    ) * pIntervalLen + 1,
    _toSum,
    INDEX(
      pStartRng,
      _seq,
      1
    ),
    _result,
    SUM(
      _toSum
    ),
    _result
  )
)